AUTH_MODE=none
LISTEN_ADDR=0.0.0.0:8080
RUST_LOG=info

# Root of the Agent Hub config tree mounted in the server container.
CONFIG_ROOT=/config

# Shared artifact store root mounted into the server container.
ARTIFACT_STORE_ROOT_HOST=./dev-data/artifacts

# Local task adapter settings.
TASK_ADAPTER=vikunja
VIKUNJA_BASE_URL=http://vikunja:3456
VIKUNJA_LABEL_PREFIX=agent-hub
VIKUNJA_PROJECT_TITLE="Agent Hub Local Dev"
VIKUNJA_BOT_USERNAME=agent-hub
VIKUNJA_BOT_EMAIL=agent-hub@example.local
VIKUNJA_BOT_PASSWORD=change-me-local-dev
VIKUNJA_JWT_SECRET=change-me-local-dev-jwt-secret

# Filled in by bootstrap-vikunja.sh
VIKUNJA_TOKEN=
VIKUNJA_PROJECT_ID=

# GitHub local polling mode (instead of webhook tunnel).
GITHUB_POLLING_ENABLED=true
GITHUB_POLL_INTERVAL_SECS=30
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=
