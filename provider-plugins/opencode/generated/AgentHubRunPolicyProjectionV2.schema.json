{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentHubRunPolicyProjectionV2",
  "description": "Strict policy surface derived from a verified canonical execution. Policy\nmatching never receives the canonical transport or public intent fields.",
  "type": "object",
  "properties": {
    "approval_rules": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalRuleSet"
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentHubRunCapabilityProjectionV1"
      },
      "maxItems": 64
    },
    "context_roots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentHubRunRootProjectionV1"
      },
      "maxItems": 16
    },
    "cpu_limit": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_network_grants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AttendedNetworkGrantV1"
      },
      "maxItems": 16
    },
    "environment": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "image_family": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1
    },
    "memory_limit": {
      "type": [
        "string",
        "null"
      ]
    },
    "network_class": {
      "type": "string",
      "maxLength": 32,
      "minLength": 1
    },
    "network_resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NetworkResourceKind"
      },
      "maxItems": 16
    },
    "output_limits": {
      "$ref": "#/$defs/AttendedOutputLimits"
    },
    "overlays": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentHubRunCapabilityProjectionV1"
      },
      "maxItems": 16
    },
    "permissions": {
      "$ref": "#/$defs/AgentHubRunPermissionSetV2"
    },
    "pids_limit": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "prompt_digest": {
      "type": "string"
    },
    "repository_claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlannedRepoClaim"
      }
    },
    "retry": {
      "$ref": "#/$defs/AttendedRetryConstraints"
    },
    "review": {
      "$ref": "#/$defs/AgentHubRunReviewProjectionV1"
    },
    "schema": {
      "type": "string"
    },
    "timeout_secs": {
      "type": "integer",
      "format": "uint64",
      "maximum": 86400,
      "minimum": 1
    },
    "tool_approval": {
      "type": "string",
      "maxLength": 16,
      "minLength": 1
    },
    "workspaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentHubRunRootProjectionV1"
      },
      "maxItems": 16,
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "environment",
    "image_family",
    "network_class",
    "network_resources",
    "effective_network_grants",
    "tool_approval",
    "workspaces",
    "context_roots",
    "overlays",
    "capabilities",
    "timeout_secs",
    "retry",
    "output_limits",
    "pids_limit",
    "permissions",
    "repository_claims",
    "prompt_digest",
    "review"
  ],
  "$defs": {
    "AgentHubRunCapabilityProjectionV1": {
      "type": "object",
      "properties": {
        "access": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        },
        "constraints": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "maxItems": 32
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "access"
      ]
    },
    "AgentHubRunPermissionSetV2": {
      "type": "object",
      "properties": {
        "auto_approve_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aws_access": {
          "type": [
            "string",
            "null"
          ]
        },
        "can_access_network": {
          "type": "boolean"
        },
        "can_read_workspace": {
          "type": "boolean"
        },
        "can_run_shell": {
          "type": "boolean"
        },
        "can_write_workspace": {
          "type": "boolean"
        },
        "escalate_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kubernetes_access": {
          "type": [
            "string",
            "null"
          ]
        },
        "tier": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "tier",
        "can_read_workspace",
        "can_write_workspace",
        "can_run_shell",
        "can_access_network",
        "auto_approve_tools",
        "escalate_tools"
      ]
    },
    "AgentHubRunReviewProjectionV1": {
      "type": "object",
      "properties": {
        "primary_workspace": {
          "type": "string",
          "maxLength": 63,
          "minLength": 1
        },
        "workspace_export_root": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "primary_workspace"
      ]
    },
    "AgentHubRunRootProjectionV1": {
      "type": "object",
      "properties": {
        "access": {
          "$ref": "#/$defs/WorkspaceAccess"
        },
        "alias": {
          "type": "string",
          "maxLength": 63,
          "minLength": 1
        },
        "path": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "alias",
        "path",
        "access"
      ]
    },
    "ApprovalRuleSet": {
      "type": "object",
      "properties": {
        "auto_approve": {
          "description": "Tools that are auto-approved for this job",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "deny": {
          "description": "Tools that are denied entirely",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "escalate": {
          "description": "Tools that always escalate to human for this job",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "AttendedNetworkGrantModeV1": {
      "type": "string",
      "enum": [
        "hosts",
        "guarded_web"
      ]
    },
    "AttendedNetworkGrantV1": {
      "type": "object",
      "properties": {
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "$ref": "#/$defs/AttendedNetworkGrantModeV1"
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "resource": {
          "$ref": "#/$defs/NetworkResourceKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "mode",
        "hosts"
      ]
    },
    "AttendedOutputLimits": {
      "type": "object",
      "properties": {
        "artifact_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "stderr_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "stdout_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "transcript_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "stdout_bytes",
        "stderr_bytes",
        "transcript_bytes",
        "artifact_bytes"
      ]
    },
    "AttendedRetryConstraints": {
      "type": "object",
      "properties": {
        "max_attempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_prelaunch_retries": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_provider_unavailable_retries": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "max_prelaunch_retries",
        "max_provider_unavailable_retries"
      ]
    },
    "NetworkResourceKind": {
      "type": "string",
      "enum": [
        "llm",
        "github",
        "go_registry",
        "crates_registry",
        "pypi_registry",
        "npm_registry",
        "guarded_web"
      ]
    },
    "PlannedRepoClaim": {
      "type": "object",
      "properties": {
        "base_ref": {
          "type": "string"
        },
        "branch_name": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "claim_type": {
          "type": "string",
          "default": ""
        },
        "read_only": {
          "type": "boolean",
          "default": false
        },
        "repo_url": {
          "type": "string"
        },
        "target_branch": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "repo_url",
        "base_ref"
      ]
    },
    "WorkspaceAccess": {
      "type": "string",
      "enum": [
        "read_only",
        "read_write"
      ]
    }
  }
}
