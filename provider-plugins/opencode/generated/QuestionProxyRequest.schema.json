{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuestionProxyRequest",
  "description": "Request body sent by the gateway when a question needs proxying.",
  "type": "object",
  "properties": {
    "cwd": {
      "type": "string",
      "maxLength": 4096,
      "minLength": 1
    },
    "id": {
      "description": "Gateway-generated UUID used as an idempotency key.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "provider": {
      "description": "Provider that originated the question (always \"opencode\" for now).",
      "type": "string",
      "maxLength": 64,
      "minLength": 1
    },
    "question_request_id": {
      "description": "The opencode-native question ID (e.g. \"que_01j...\").",
      "type": "string",
      "maxLength": 256,
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/QuestionInfo"
      },
      "maxItems": 32,
      "minItems": 1
    },
    "session_display_name": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "session_id",
    "session_display_name",
    "cwd",
    "question_request_id",
    "questions",
    "provider"
  ],
  "$defs": {
    "QuestionInfo": {
      "description": "One question with its choices.",
      "type": "object",
      "properties": {
        "custom": {
          "description": "If true (default), a free-text \"Type your own answer\" input is shown.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "header": {
          "description": "Short label (≤30 chars) shown as the tab/step heading.",
          "type": "string",
          "maxLength": 30,
          "minLength": 1
        },
        "multiple": {
          "description": "If true, multiple options may be selected simultaneously.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestionOption"
          },
          "maxItems": 64
        },
        "question": {
          "type": "string",
          "maxLength": 4096,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "question",
        "header",
        "options"
      ]
    },
    "QuestionOption": {
      "description": "A single selectable option within a question.",
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "label": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "description"
      ]
    }
  }
}
